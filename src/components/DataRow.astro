---
export interface Props {
  date?: string;
  title?: string;
  description: string;
  subTitle?: string;
  link?: string;
}

const { description, date, title, subTitle, link } = Astro.props;
---

<div class="flex flex-row justify-start mx-2 dark:text-white pb-2">
  {
    date && (
      <div class="flex flex-col pr-6">
        {date.split(" ").map((d: string) => (
          <div class={"mb-1"}>{d}</div>
        ))}
      </div>
    )
  }

  <div class="flex-1">
    <div class="flex gap-3">
      {title && <span class="font-bold">{title}</span>} |
      {
        link ? (
          <a href={link} target="_blank" class="hover:font-semibold duration-100">
            {subTitle}
          </a>
        ) : (
          <span>{subTitle}</span>
        )
      }
    </div>
    <div>{description}</div>
  </div>
</div>
